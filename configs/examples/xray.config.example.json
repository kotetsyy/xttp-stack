{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "tag": "socks-in",
      "port": 11090,
      "listen": "127.0.0.1",
      "protocol": "socks",
      "settings": {
        "udp": true,
        "auth": "noauth"
      }
    },
    {
      "tag": "http-in",
      "port": 11091,
      "listen": "127.0.0.1",
      "protocol": "http"
    }
  ],
  "outbounds": [
    {
      "tag": "xttp",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "YOUR_SERVER_HOST",
            "port": 38770,
            "users": [
              {
                "id": "YOUR_UUID_HERE",
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "reality",
        "xhttpSettings": {
          "path": "/",
          "mode": "auto",
          "extra": {
            "mode": "auto",
            "xPaddingBytes": "100-1000"
          }
        },
        "realitySettings": {
          "serverName": "www.nvidia.com",
          "fingerprint": "firefox",
          "show": false,
          "publicKey": "YOUR_REALITY_PUBLIC_KEY_HERE",
          "shortId": "YOUR_SHORT_ID_HERE",
          "spiderX": "/f52bb8f644fb39d"
        }
      }
    },
    {
      "tag": "direct",
      "protocol": "freedom"
    },
    {
      "tag": "block",
      "protocol": "blackhole"
    }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "type": "field",
        "inboundTag": [
          "socks-in",
          "http-in"
        ],
        "outboundTag": "xttp"
      }
    ]
  }
}
