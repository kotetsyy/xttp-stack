[Unit]
Description=xttp panel (mihomo-lists web UI)
After=network.target mihomo.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/mihomo-lists/app.py
Restart=on-failure
RestartSec=2
User=root
WorkingDirectory=/opt/mihomo-lists
# Bind to loopback; access through an SSH tunnel or HTTPS reverse proxy.
Environment=XTTP_HOST=127.0.0.1
Environment=XTTP_GIT_REPO=/opt/xttp-stack

[Install]
WantedBy=multi-user.target
