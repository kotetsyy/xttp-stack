[Unit]
Description=xttp-stack fleet check-and-update (oneshot)
After=network-online.target mihomo-lists.service
Wants=network-online.target

[Service]
Type=oneshot
Environment=XTTP_GIT_REPO=/opt/xttp-stack
Environment="XTTP_FLEET_INITIATOR=автообновление (timer)"
Environment=XTTP_UPDATE_LOCK=/run/xttp-update.lock
WorkingDirectory=/
TimeoutStartSec=1h
ExecStart=/bin/bash ${XTTP_GIT_REPO}/scripts/check-and-update.sh
Nice=10

[Install]
WantedBy=multi-user.target
